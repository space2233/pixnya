# Build-time OAuth compatibility configuration.
# Keep real values in .env.oauth.local (already ignored by .gitignore).
PIXIV_OAUTH_CLIENT_ID=
PIXIV_OAUTH_CLIENT_SECRET=
PIXIV_OAUTH_HASH_SALT=

# Release update configuration. Keep signing private keys out of this file and
# out of the repository; inject them only in the protected release environment.
# Recommended endpoint form:
# https://github.com/space2233/pixnya/releases/latest/download/latest.json
# Note: the current repository is private, so this URL is not yet suitable for
# anonymous client updates. Do not embed a GitHub access token in the app.
PIXNYA_UPDATER_ENDPOINT=
PIXNYA_UPDATER_PUBKEY=
PIXNYA_ANDROID_UPDATE_MANIFEST=
# Base64 of the complete minisign public-key file, including its comment line.
# This single-line form is safe to inject as a CI secret or compile-time env var.
PIXNYA_ANDROID_UPDATE_PUBKEY=
